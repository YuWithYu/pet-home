<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pethome.mapper.TopicLikeMapper">

    <select id="checkLikeStatus" resultType="com.pethome.entity.TopicLike">
        SELECT * FROM topic_like
        WHERE topic_id = #{topicId}
        AND user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
