/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}
.btn-primary {
  background-color: #ff6b35;
  color: white;
}
.btn-primary:active {
  background-color: #ff4602;
}
.btn-secondary {
  background-color: #ffffff;
  color: #333333;
  border: 1rpx solid #e0e0e0;
}
.btn-secondary:active {
  background-color: #f0f0f0;
}
.btn-disabled {
  background-color: #f0f0f0;
  color: #999999;
  border: 1rpx solid #e0e0e0;
}
.btn-block {
  width: 100%;
}
.btn-round {
  border-radius: 40rpx;
}
/* 标签样式 */
.tag, .goods-card-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: #ff6b35;
  color: white;
  font-size: 24rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}
.tag-primary {
  background-color: #ff6b35;
}
.tag-success {
  background-color: #52c41a;
}
.tag-warning {
  background-color: #faad14;
}
.tag-danger {
  background-color: #ff4d4f;
}
/* 输入框样式 */
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 30rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}
.input:focus {
  border-color: #ff6b35;
  background-color: white;
}
.input.error {
  border-color: #ff4d4f;
  background-color: #fff1f0;
}
.input::-webkit-input-placeholder {
  color: #999999;
}
.input::placeholder {
  color: #999999;
}
/* 加载动画 */
@-webkit-keyframes spin {
0% {
    -webkit-transform: rotate(0deg);
            transform: rotate(0deg);
}
100% {
    -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
}
}
@keyframes spin {
0% {
    -webkit-transform: rotate(0deg);
            transform: rotate(0deg);
}
100% {
    -webkit-transform: rotate(360deg);
            transform: rotate(360deg);
}
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #ff6b35;
  border-radius: 50%;
  -webkit-animation: spin 1s linear infinite;
          animation: spin 1s linear infinite;
}
/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  padding: 120rpx 40rpx;
  color: #999999;
}
.empty-state-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}
.empty-state-text {
  font-size: 28rpx;
}
/* 错误状态 */
.error-state {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  padding: 120rpx 40rpx;
  color: #ff4d4f;
}
.error-state-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}
.error-state-text {
  font-size: 28rpx;
}
/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}
/* 弹出层 */
.popup {
  position: fixed;
  background-color: white;
  border-radius: 12rpx 12rpx 0 0;
  z-index: 1001;
}
.popup-bottom {
  bottom: 0;
  left: 0;
  right: 0;
}
.popup-center {
  top: 50%;
  left: 50%;
  -webkit-transform: translate(-50%, -50%);
          transform: translate(-50%, -50%);
  border-radius: 12rpx;
}
/* 导航栏扩展 */
.navbar-custom {
  background-color: #ff6b35;
  color: white;
}
/* 商品卡片 */
.goods-card {
  background-color: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.goods-card-image {
  position: relative;
  width: 100%;
  height: 280rpx;
}
.goods-card-image image {
  width: 100%;
  height: 100%;
}
.goods-card-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
}
.goods-card-info {
  padding: 20rpx;
}
.goods-card-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.goods-card-price {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.goods-card-price-current {
  font-size: 32rpx;
  color: #ff6b35;
  font-weight: bold;
}
.goods-card-price-original {
  font-size: 24rpx;
  color: #999999;
  text-decoration: line-through;
  margin-left: 10rpx;
}
.goods-card-sales {
  font-size: 24rpx;
  color: #999999;
}
/* 搜索栏 */
.search-bar {
  display: flex;
  justify-content: center;
  padding: 20rpx 30rpx;
  background-color: white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.search-bar-input {
  flex: 1;
  display: flex;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  padding: 16rpx 30rpx;
  margin-right: 20rpx;
}
.search-bar-icon {
  margin-right: 16rpx;
  color: #999999;
  font-size: 28rpx;
}
.search-bar-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}
.search-bar-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #ff6b35;
  display: flex;
  justify-content: center;
  align-items: center;
}
.app {
  width: 100%;
  min-height: 100vh;
  background-color: #f8f8f8;
}
