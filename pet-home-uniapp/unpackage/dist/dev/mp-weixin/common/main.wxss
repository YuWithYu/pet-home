  color: #ff6b35;
}
.text-secondary {
  color: #666;
}
.text-success {
  color: #52c41a;
}
.text-warning {
  color: #faad14;
}
.text-danger {
  color: #ff4d4f;
}
.text-center {
  text-align: center;
}
.text-left {
  text-align: left;
}
.text-right {
  text-align: right;
}
