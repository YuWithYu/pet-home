<view class="verify-container data-v-205fafb2"><view class="header data-v-205fafb2"><view class="title data-v-205fafb2">订单核销</view><view class="subtitle data-v-205fafb2">扫描客户二维码进行核销</view></view><view class="scan-section data-v-205fafb2"><view data-event-opts="{{[['tap',[['scanQRCode',['$event']]]]]}}" class="scan-button data-v-205fafb2" bindtap="__e"><view class="scan-icon data-v-205fafb2">📱</view><view class="scan-text data-v-205fafb2">扫描二维码</view></view></view><view class="manual-input-section data-v-205fafb2"><view class="section-title data-v-205fafb2">或手动输入核销码</view><view class="input-container data-v-205fafb2"><input class="verify-input data-v-205fafb2" placeholder="请输入核销码" data-event-opts="{{[['confirm',[['verifyManualCode',['$event']]]],['input',[['__set_model',['','manualCode','$event',[]]]]]]}}" value="{{manualCode}}" bindconfirm="__e" bindinput="__e"/><view data-event-opts="{{[['tap',[['verifyManualCode',['$event']]]]]}}" class="verify-button data-v-205fafb2" bindtap="__e">验证</view></view></view><block wx:if="{{verifyResult}}"><view class="result-section data-v-205fafb2"><view class="{{['result-card','data-v-205fafb2',verifyResult.success?'success':'error']}}"><view class="result-icon data-v-205fafb2">{{verifyResult.success?'✓':'✗'}}</view><view class="result-title data-v-205fafb2">{{verifyResult.success?'核销成功':'核销失败'}}</view><view class="result-message data-v-205fafb2">{{verifyResult.message}}</view><block wx:if="{{verifyResult.success&&verifyResult.data}}"><view class="order-info data-v-205fafb2"><view class="info-item data-v-205fafb2"><text class="label data-v-205fafb2">订单号：</text><text class="value data-v-205fafb2">{{verifyResult.data.id}}</text></view><view class="info-item data-v-205fafb2"><text class="label data-v-205fafb2">服务类型：</text><text class="value data-v-205fafb2">{{$root.m0}}</text></view><view class="info-item data-v-205fafb2"><text class="label data-v-205fafb2">预约时间：</text><text class="value data-v-205fafb2">{{$root.m1}}</text></view><view class="info-item data-v-205fafb2"><text class="label data-v-205fafb2">核销时间：</text><text class="value data-v-205fafb2">{{$root.m2}}</text></view></view></block></view></view></block><block wx:if="{{$root.g0>0}}"><view class="history-section data-v-205fafb2"><view class="section-title data-v-205fafb2">今日核销记录</view><view class="history-list data-v-205fafb2"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="history-item data-v-205fafb2"><view class="history-info data-v-205fafb2"><view class="order-id data-v-205fafb2">{{"订单："+item.$orig.id}}</view><view class="verify-time data-v-205fafb2">{{item.m3}}</view></view><view class="history-status success data-v-205fafb2">已核销</view></view></block></view></view></block></view>