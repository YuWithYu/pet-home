<view class="goods-detail-container data-v-f0a9f5ba"><block wx:if="{{loading}}"><view class="loading-container data-v-f0a9f5ba"><text class="data-v-f0a9f5ba">加载中...</text></view></block><block wx:else><block wx:if="{{goods}}"><view class="data-v-f0a9f5ba"><block wx:if="{{$root.g0}}"><swiper class="goods-swiper data-v-f0a9f5ba" indicator-dots="true" autoplay="true" circular="true"><block wx:for="{{goods.images}}" wx:for-item="image" wx:for-index="__i0__" wx:key="*this"><swiper-item class="data-v-f0a9f5ba"><image src="{{image}}" mode="aspectFill" class="data-v-f0a9f5ba"></image></swiper-item></block></swiper></block><view class="goods-info bg-white data-v-f0a9f5ba"><view class="goods-name data-v-f0a9f5ba">{{goods.name}}</view><view class="goods-desc data-v-f0a9f5ba">{{goods.description}}</view><view class="goods-price data-v-f0a9f5ba"><text class="price-current data-v-f0a9f5ba">{{goods.price}}</text><block wx:if="{{goods.originalPrice}}"><text class="price-original data-v-f0a9f5ba">{{"¥"+goods.originalPrice}}</text></block></view><block wx:if="{{goods.sales}}"><view class="goods-sales data-v-f0a9f5ba">{{'已售 '+goods.sales+' 件'}}</view></block></view><block wx:if="{{$root.g1}}"><view class="goods-spec bg-white data-v-f0a9f5ba"><view class="spec-title data-v-f0a9f5ba">规格选择</view><view class="spec-list data-v-f0a9f5ba"><block wx:for="{{goods.specs}}" wx:for-item="spec" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['selectSpec',['$0'],[[['goods.specs','id',spec.id]]]]]]]}}" class="{{['data-v-f0a9f5ba','spec-item',[(selectedSpec.id===item.id)?'active':'']]}}" bindtap="__e">{{''+spec.name+''}}</view></block></view></view></block><view class="goods-detail bg-white data-v-f0a9f5ba"><view class="detail-title data-v-f0a9f5ba">商品详情</view><view class="detail-content data-v-f0a9f5ba"><block wx:if="{{goods.detail}}"><u-parse vue-id="6db62043-1" content="{{goods.detail}}" class="data-v-f0a9f5ba" bind:__l="__l"></u-parse></block><block wx:else><view class="no-detail data-v-f0a9f5ba">暂无详情内容</view></block></view></view><block wx:if="{{$root.g2}}"><view class="goods-comments bg-white data-v-f0a9f5ba"><view class="comments-title data-v-f0a9f5ba">用户评价</view><view class="comments-list data-v-f0a9f5ba"><block wx:for="{{$root.l0}}" wx:for-item="comment" wx:for-index="__i2__" wx:key="id"><view class="comment-item data-v-f0a9f5ba"><view class="comment-header data-v-f0a9f5ba"><view class="comment-avatar data-v-f0a9f5ba">👤</view><view class="comment-info data-v-f0a9f5ba"><view class="comment-name data-v-f0a9f5ba">{{comment.$orig.userName}}</view><view class="comment-time data-v-f0a9f5ba">{{comment.$orig.time}}</view></view></view><view class="comment-content data-v-f0a9f5ba">{{comment.$orig.content}}</view><block wx:if="{{comment.g3}}"><view class="comment-images data-v-f0a9f5ba"><block wx:for="{{comment.$orig.images}}" wx:for-item="image" wx:for-index="__i3__" wx:key="*this"><image src="{{image}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewImage',['$0','$1'],[[['goods.comments','id',comment.$orig.id,'images']],[['goods.comments','id',comment.$orig.id],['images','',__i3__]]]]]]]}}" bindtap="__e" class="data-v-f0a9f5ba"></image></block></view></block></view></block></view></view></block><view class="goods-footer data-v-f0a9f5ba"><view class="footer-actions data-v-f0a9f5ba"><view data-event-opts="{{[['tap',[['onServiceTap',['$event']]]]]}}" class="action-item data-v-f0a9f5ba" bindtap="__e"><view class="action-icon data-v-f0a9f5ba">💬</view><view class="action-text data-v-f0a9f5ba">客服</view></view><view data-event-opts="{{[['tap',[['onCartTap',['$event']]]]]}}" class="action-item data-v-f0a9f5ba" bindtap="__e"><view class="action-icon data-v-f0a9f5ba">🛒</view><view class="action-text data-v-f0a9f5ba">购物车</view></view><view data-event-opts="{{[['tap',[['addToCart',['$event']]]]]}}" class="action-item data-v-f0a9f5ba" bindtap="__e"><view class="action-text data-v-f0a9f5ba">加入购物车</view></view><view data-event-opts="{{[['tap',[['buyNow',['$event']]]]]}}" class="buy-now data-v-f0a9f5ba" bindtap="__e"><view class="buy-text data-v-f0a9f5ba">立即购买</view></view></view></view></view></block></block></view>