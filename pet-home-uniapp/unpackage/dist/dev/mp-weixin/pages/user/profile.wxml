<view class="profile-container data-v-64c291de"><view class="profile-form data-v-64c291de"><u-form vue-id="33902ae8-1" model="{{form}}" data-ref="form" class="data-v-64c291de vue-ref" bind:__l="__l" vue-slots="{{['default']}}"><view class="form-item data-v-64c291de"><view class="form-label data-v-64c291de">头像</view><view data-event-opts="{{[['tap',[['chooseAvatar',['$event']]]]]}}" class="avatar-section data-v-64c291de" bindtap="__e"><view class="avatar-wrapper data-v-64c291de"><block wx:if="{{form.avatar}}"><image src="{{form.avatar}}" mode="aspectFill" class="data-v-64c291de"></image></block><block wx:else><view class="avatar-placeholder data-v-64c291de">👤</view></block></view><view class="avatar-text data-v-64c291de">点击更换头像</view></view></view><view class="form-item data-v-64c291de"><view class="form-label data-v-64c291de">昵称</view><input class="form-input data-v-64c291de" placeholder="请输入昵称" data-event-opts="{{[['input',[['__set_model',['$0','nickname','$event',[]],['form']]]]]}}" value="{{form.nickname}}" bindinput="__e"/></view><view class="form-item data-v-64c291de"><view class="form-label data-v-64c291de">性别</view><view class="radio-group data-v-64c291de"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="{{['data-v-64c291de','radio-item',[(form.gender==='0')?'active':'']]}}" bindtap="__e">男</view><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="{{['data-v-64c291de','radio-item',[(form.gender==='1')?'active':'']]}}" bindtap="__e">女</view><view data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="{{['data-v-64c291de','radio-item',[(form.gender==='2')?'active':'']]}}" bindtap="__e">其他</view></view></view><view class="form-item data-v-64c291de"><view class="form-label data-v-64c291de">生日</view><picker mode="date" value="{{form.birthday}}" data-event-opts="{{[['change',[['onBirthdayChange',['$event']]]]]}}" bindchange="__e" class="data-v-64c291de"><view class="picker-input data-v-64c291de">{{form.birthday||'请选择生日'}}</view></picker></view><view class="form-item data-v-64c291de"><view class="form-label data-v-64c291de">地区</view><picker mode="region" value="{{regionValue}}" data-event-opts="{{[['change',[['onRegionChange',['$event']]]]]}}" bindchange="__e" class="data-v-64c291de"><view class="picker-input data-v-64c291de">{{form.region||'请选择地区'}}</view></picker></view><view class="form-item data-v-64c291de"><view class="form-label data-v-64c291de">个性签名</view><textarea class="form-textarea data-v-64c291de" placeholder="请输入个性签名" maxlength="100" data-event-opts="{{[['input',[['__set_model',['$0','signature','$event',[]],['form']]]]]}}" value="{{form.signature}}" bindinput="__e"></textarea></view><view class="save-section data-v-64c291de"><button class="{{['data-v-64c291de','save-btn',[(canSave)?'primary':'',(!canSave)?'disabled':'']]}}" disabled="{{!canSave}}" data-event-opts="{{[['tap',[['saveProfile',['$event']]]]]}}" bindtap="__e">{{''+(saving?'保存中...':'保存资料')+''}}</button></view></u-form></view></view>