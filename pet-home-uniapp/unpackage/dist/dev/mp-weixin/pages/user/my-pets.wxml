<view class="my-pets-container data-v-6410d4ea"><view class="custom-white-navbar data-v-6410d4ea" style="{{'padding-top:'+(statusBarHeight+'px')+';'}}"><view class="navbar-content data-v-6410d4ea"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="navbar-left data-v-6410d4ea" bindtap="__e"><text class="back-icon data-v-6410d4ea">‹</text></view><view class="navbar-title data-v-6410d4ea"><text class="data-v-6410d4ea">我的宠物</text></view><view class="navbar-right data-v-6410d4ea"></view></view></view><view class="pets-content data-v-6410d4ea" style="{{'padding-top:'+(navBarTotalHeight+'px')+';'}}"><block wx:for="{{$root.l0}}" wx:for-item="pet" wx:for-index="index" wx:key="id"><block wx:if="{{hasPets}}"><view class="pet-info-card data-v-6410d4ea"><view class="pet-number data-v-6410d4ea">{{index+1}}</view><view class="pet-status-tag data-v-6410d4ea"><text class="status-icon data-v-6410d4ea">{{pet.$orig.gender==='male'?'♂':'♀'}}</text><text class="status-text data-v-6410d4ea">{{pet.m0}}</text></view><view class="pet-details data-v-6410d4ea"><view class="detail-item data-v-6410d4ea"><text class="detail-icon data-v-6410d4ea">⚖</text><text class="detail-text data-v-6410d4ea">{{pet.$orig.weight+"kg"}}</text></view><view class="detail-item data-v-6410d4ea"><text class="detail-icon data-v-6410d4ea">🎂</text><text class="detail-text data-v-6410d4ea">{{pet.$orig.birthDate}}</text></view><view class="detail-item data-v-6410d4ea"><text class="detail-text data-v-6410d4ea">{{pet.$orig.age+"岁|"+pet.$orig.companionshipDays+"天陪伴"}}</text></view><view class="divider data-v-6410d4ea"></view><view class="detail-item data-v-6410d4ea"><text class="detail-text data-v-6410d4ea">{{"累计获食: "+pet.$orig.totalFood+"g"}}</text></view></view><view class="pet-avatar data-v-6410d4ea"><image src="{{pet.$orig.avatar}}" mode="aspectFill" class="data-v-6410d4ea"></image></view><view data-event-opts="{{[['tap',[['editPetProfile',['$0'],[[['petList','id',pet.$orig.id]]]]]]]}}" class="edit-button data-v-6410d4ea" bindtap="__e"><text class="data-v-6410d4ea">编辑资料 ></text></view></view></block></block><view class="add-pet-container data-v-6410d4ea"><view data-event-opts="{{[['tap',[['addPetProfile',['$event']]]]]}}" class="add-pet-card data-v-6410d4ea" bindtap="__e"><view class="add-icon data-v-6410d4ea"><text class="data-v-6410d4ea">+</text></view><view class="add-text data-v-6410d4ea"><text class="data-v-6410d4ea">添加宠物档案</text></view></view></view></view></view>