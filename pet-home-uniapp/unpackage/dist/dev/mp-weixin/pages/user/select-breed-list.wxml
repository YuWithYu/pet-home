<view class="select-breed-list-container"><view class="custom-white-navbar" style="{{'padding-top:'+(statusBarHeight+'px')+';'}}"><view class="navbar-content"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="navbar-left" bindtap="__e"><text class="back-icon">‹</text></view><view class="navbar-title"><text>选择品种</text></view><view class="navbar-right"></view></view></view><scroll-view class="breed-list-scroll-content" style="{{'padding-top:'+(navBarTotalHeight+'px')+';'}}" scroll-y="{{true}}" scroll-into-view="{{scrollViewId}}" scroll-with-animation="{{true}}"><view class="search-section"><view class="search-input-container"><text class="search-icon">🔍</text><input class="search-input" type="text" placeholder="点击搜索品种" data-event-opts="{{[['input',[['__set_model',['','searchText','$event',[]]],['onSearchInput',['$event']]]]]}}" value="{{searchText}}" bindinput="__e"/></view></view><block wx:if="{{$root.g0}}"><view class="hot-breeds-section"><view class="section-title">热门品种</view><view class="hot-breeds-grid"><block wx:for="{{filteredHotBreeds}}" wx:for-item="breed" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectBreed',['$0'],[[['filteredHotBreeds','',index]]]]]]]}}" class="breed-tag" bindtap="__e"><text>{{breed}}</text></view></block></view></view></block><view class="alphabetical-breeds-section"><block wx:for="{{filteredAlphabeticalBreeds}}" wx:for-item="group" wx:for-index="index" wx:key="index"><view><view class="initial-group" id="{{'initial-'+group.initial}}"><view class="initial-header">{{group.initial}}</view><block wx:for="{{group.breeds}}" wx:for-item="breed" wx:for-index="bIndex" wx:key="bIndex"><view data-event-opts="{{[['tap',[['selectBreed',['$0'],[[['filteredAlphabeticalBreeds','',index],['breeds','',bIndex]]]]]]]}}" class="breed-item" bindtap="__e"><text>{{breed}}</text></view></block></view></view></block></view></scroll-view><view class="alphabet-index" style="{{'padding-top:'+(navBarTotalHeight+'px')+';'}}"><block wx:for="{{alphabetIndex}}" wx:for-item="initial" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['scrollToInitial',['$0'],[[['alphabetIndex','',index]]]]]]]}}" class="index-item" bindtap="__e"><text class="{{[(activeInitial===initial)?'active':'']}}">{{initial}}</text></view></block></view></view>