<view class="edit-pet-profile data-v-0d4a24d3"><view class="custom-navbar data-v-0d4a24d3"><view class="navbar-content data-v-0d4a24d3"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="navbar-left data-v-0d4a24d3" bindtap="__e"><text class="back-icon data-v-0d4a24d3">‹</text></view><view class="navbar-title data-v-0d4a24d3"><text class="title-text data-v-0d4a24d3">编辑宠物资料</text></view><view class="navbar-right data-v-0d4a24d3"></view></view></view><view class="page-content data-v-0d4a24d3"><view class="pet-avatar-section data-v-0d4a24d3"><view class="avatar-container data-v-0d4a24d3"><image class="pet-avatar data-v-0d4a24d3" src="{{petData.avatar||'/static/images/garfield-default-avatar.png'}}" mode="aspectFill"></image><view data-event-opts="{{[['tap',[['chooseAvatar',['$event']]]]]}}" class="camera-btn data-v-0d4a24d3" bindtap="__e"><text class="camera-icon data-v-0d4a24d3">📷</text></view></view><view class="nickname-input data-v-0d4a24d3"><input class="name-input data-v-0d4a24d3" placeholder="请输入昵称" maxlength="10" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['petData']]]]]}}" value="{{petData.name}}" bindinput="__e"/><view data-event-opts="{{[['tap',[['nextStep',['$event']]]]]}}" class="next-btn data-v-0d4a24d3" bindtap="__e"><text class="next-text data-v-0d4a24d3">下一步</text></view></view></view><view class="pet-form data-v-0d4a24d3"><view class="form-item data-v-0d4a24d3"><text class="item-label data-v-0d4a24d3">宠物名字</text><view class="item-content data-v-0d4a24d3"><input class="item-input data-v-0d4a24d3" placeholder="请输入宠物名字" maxlength="10" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['petData']]]]]}}" value="{{petData.name}}" bindinput="__e"/><text class="item-arrow data-v-0d4a24d3">1></text></view></view><view data-event-opts="{{[['tap',[['selectBreed',['$event']]]]]}}" class="form-item data-v-0d4a24d3" bindtap="__e"><text class="item-label data-v-0d4a24d3">宠物品种</text><view class="item-content data-v-0d4a24d3"><text class="item-value data-v-0d4a24d3">{{petData.breed||'请选择品种'}}</text><text class="item-arrow data-v-0d4a24d3">></text></view></view><view class="form-item data-v-0d4a24d3"><text class="item-label data-v-0d4a24d3">宠物性别</text><view class="gender-options data-v-0d4a24d3"><view data-event-opts="{{[['tap',[['selectGender',['male']]]]]}}" class="{{['gender-btn','data-v-0d4a24d3',(petData.gender==='male')?'active':'']}}" bindtap="__e"><text class="gender-text data-v-0d4a24d3">男孩子</text></view><view data-event-opts="{{[['tap',[['selectGender',['female']]]]]}}" class="{{['gender-btn','data-v-0d4a24d3',(petData.gender==='female')?'active':'']}}" bindtap="__e"><text class="gender-text data-v-0d4a24d3">女孩子</text></view></view></view><view class="form-item data-v-0d4a24d3"><text class="item-label data-v-0d4a24d3">绝育状态</text><view class="sterilization-options data-v-0d4a24d3"><view data-event-opts="{{[['tap',[['selectSterilization',['no']]]]]}}" class="{{['sterilization-btn','data-v-0d4a24d3',(petData.sterilization==='no')?'active':'']}}" bindtap="__e"><text class="sterilization-text data-v-0d4a24d3">未绝育</text></view><view data-event-opts="{{[['tap',[['selectSterilization',['yes']]]]]}}" class="{{['sterilization-btn','data-v-0d4a24d3',(petData.sterilization==='yes')?'active':'']}}" bindtap="__e"><text class="sterilization-text data-v-0d4a24d3">已绝育</text></view><view data-event-opts="{{[['tap',[['selectSterilization',['unknown']]]]]}}" class="{{['sterilization-btn','data-v-0d4a24d3',(petData.sterilization==='unknown')?'active':'']}}" bindtap="__e"><text class="sterilization-text data-v-0d4a24d3">不清楚</text></view></view></view><view class="form-item data-v-0d4a24d3"><text class="item-label data-v-0d4a24d3">相亲意愿</text><view class="dating-options data-v-0d4a24d3"><view data-event-opts="{{[['tap',[['selectDating',['no']]]]]}}" class="{{['dating-btn','data-v-0d4a24d3',(petData.dating==='no')?'active':'']}}" bindtap="__e"><text class="dating-text data-v-0d4a24d3">没有</text></view><view data-event-opts="{{[['tap',[['selectDating',['yes']]]]]}}" class="{{['dating-btn','data-v-0d4a24d3',(petData.dating==='yes')?'active':'']}}" bindtap="__e"><text class="dating-text data-v-0d4a24d3">有</text></view></view></view><view data-event-opts="{{[['tap',[['editWeight',['$event']]]]]}}" class="form-item data-v-0d4a24d3" bindtap="__e"><text class="item-label data-v-0d4a24d3">宠物体重</text><view class="item-content data-v-0d4a24d3"><text class="item-value data-v-0d4a24d3">{{petData.weight+" kg"}}</text><text class="item-arrow data-v-0d4a24d3">></text></view></view><view data-event-opts="{{[['tap',[['selectBirthDate',['$event']]]]]}}" class="form-item data-v-0d4a24d3" bindtap="__e"><text class="item-label data-v-0d4a24d3">出生日期</text><view class="item-content data-v-0d4a24d3"><text class="item-value data-v-0d4a24d3">{{petData.birthDate||'请选择日期'}}</text><text class="item-arrow data-v-0d4a24d3">></text></view></view><view data-event-opts="{{[['tap',[['selectArrivalDate',['$event']]]]]}}" class="form-item data-v-0d4a24d3" bindtap="__e"><text class="item-label data-v-0d4a24d3">到家日期</text><view class="item-content data-v-0d4a24d3"><text class="item-value data-v-0d4a24d3">{{petData.arrivalDate||'请选择日期'}}</text><text class="item-arrow data-v-0d4a24d3">></text></view></view><view data-event-opts="{{[['tap',[['editDescription',['$event']]]]]}}" class="form-item data-v-0d4a24d3" bindtap="__e"><text class="item-label data-v-0d4a24d3">一句话描述</text><view class="item-content data-v-0d4a24d3"><text class="item-value data-v-0d4a24d3">{{petData.description||'爱吃啥,有啥特点~>'}}</text><text class="item-arrow data-v-0d4a24d3">></text></view></view></view><view class="tip-text data-v-0d4a24d3"><text class="tip data-v-0d4a24d3">出生日期/到家日期不记得可以估算一个值,后续可以修改哦~</text></view><view data-event-opts="{{[['tap',[['saveEdit',['$event']]]]]}}" class="save-btn data-v-0d4a24d3" bindtap="__e"><text class="save-text data-v-0d4a24d3">保存编辑</text></view></view></view>