<view class="cart-container data-v-457cfe48"><block wx:if="{{$root.g0===0}}"><view class="empty-cart data-v-457cfe48"><view class="empty-icon data-v-457cfe48">🛒</view><view class="empty-text data-v-457cfe48">购物车还是空的</view><view class="empty-desc data-v-457cfe48">快去添加一些商品吧</view><button data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="go-home-btn data-v-457cfe48" bindtap="__e">去首页逛逛</button></view></block><block wx:else><view class="cart-list data-v-457cfe48"><block wx:for="{{cartList}}" wx:for-item="item" wx:for-index="index" wx:key="id"><view class="cart-item data-v-457cfe48"><view class="item-checkbox data-v-457cfe48"><checkbox checked="{{item.selected}}" data-event-opts="{{[['change',[['onItemSelect',['$0'],[[['cartList','id',item.id,'id']]]]]]]}}" bindchange="__e" class="data-v-457cfe48"></checkbox><view class="item-info data-v-457cfe48"><view class="item-image data-v-457cfe48"><image src="{{item.pic}}" mode="aspectFill" class="data-v-457cfe48"></image></view><view class="item-details data-v-457cfe48"><view class="item-name data-v-457cfe48">{{item.name}}</view><block wx:if="{{item.spec}}"><view class="item-spec data-v-457cfe48">{{item.spec}}</view></block><view class="item-price data-v-457cfe48"><text class="price-current data-v-457cfe48">{{item.price}}</text><block wx:if="{{item.originalPrice}}"><text class="price-original data-v-457cfe48">{{"¥"+item.originalPrice}}</text></block></view></view></view></view><view class="item-actions data-v-457cfe48"><view class="quantity-control data-v-457cfe48"><button data-event-opts="{{[['tap',[['changeQuantity',['$0',-1],[[['cartList','id',item.id,'id']]]]]]]}}" class="quantity-btn data-v-457cfe48" bindtap="__e">-</button><input class="quantity-input data-v-457cfe48" type="number" data-event-opts="{{[['change',[['onQuantityChange',['$0','$event'],[[['cartList','id',item.id,'id']]]]]]]}}" value="{{item.quantity}}" bindchange="__e"/><button data-event-opts="{{[['tap',[['changeQuantity',['$0',1],[[['cartList','id',item.id,'id']]]]]]]}}" class="quantity-btn data-v-457cfe48" bindtap="__e">+</button></view></view></view></block><view class="cart-footer data-v-457cfe48"><view class="footer-left data-v-457cfe48"><checkbox checked="{{allSelected}}" data-event-opts="{{[['change',[['onSelectAll',['$event']]]]]}}" bindchange="__e" class="data-v-457cfe48"></checkbox><text class="select-all-text data-v-457cfe48">全选</text></view><view class="footer-right data-v-457cfe48"><view class="total-info data-v-457cfe48"><view class="total-text data-v-457cfe48">合计：<text class="total-price data-v-457cfe48">{{$root.m0}}</text></view><block wx:if="{{discountAmount>0}}"><view class="discount-text data-v-457cfe48">{{'优惠：-'+$root.m1+''}}</view></block></view><button class="checkout-btn data-v-457cfe48" disabled="{{!hasSelectedItems}}" data-event-opts="{{[['tap',[['onCheckout',['$event']]]]]}}" bindtap="__e">{{'去结算('+selectedCount+')'}}</button></view></view></view></block></view>