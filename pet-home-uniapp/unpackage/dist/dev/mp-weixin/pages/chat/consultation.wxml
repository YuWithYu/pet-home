<view class="chat-container data-v-658354b7"><view class="chat-header data-v-658354b7"><view class="doctor-info data-v-658354b7"><image class="doctor-avatar data-v-658354b7" src="{{doctorInfo.avatar}}" mode="aspectFill"></image><view class="doctor-details data-v-658354b7"><text class="doctor-name data-v-658354b7">{{doctorInfo.name}}</text><text class="doctor-specialty data-v-658354b7">{{doctorInfo.specialty}}</text></view></view><view class="chat-status data-v-658354b7"><text class="status-text data-v-658354b7">在线</text></view></view><scroll-view class="message-list data-v-658354b7" scroll-y="{{true}}" scroll-top="{{scrollTop}}" scroll-with-animation="{{true}}"><block wx:for="{{messages}}" wx:for-item="message" wx:for-index="index" wx:key="index"><view class="{{['message-item','data-v-658354b7',(message.isUser)?'user-message':'',(!message.isUser)?'doctor-message':'']}}"><block wx:if="{{!message.isUser}}"><view class="message-avatar data-v-658354b7"><image src="{{doctorInfo.avatar}}" mode="aspectFill" class="data-v-658354b7"></image></view></block><view class="message-content data-v-658354b7"><view class="message-bubble data-v-658354b7"><text class="message-text data-v-658354b7">{{message.content}}</text></view><view class="message-time data-v-658354b7">{{message.time}}</view></view><block wx:if="{{message.isUser}}"><view class="message-avatar data-v-658354b7"><image src="{{userAvatar}}" mode="aspectFill" class="data-v-658354b7"></image></view></block></view></block></scroll-view><view class="input-area data-v-658354b7"><view class="input-container data-v-658354b7"><input class="message-input data-v-658354b7" placeholder="请输入您的问题..." data-event-opts="{{[['confirm',[['sendMessage',['$event']]]],['input',[['__set_model',['','inputMessage','$event',[]]]]]]}}" value="{{inputMessage}}" bindconfirm="__e" bindinput="__e"/><view data-event-opts="{{[['tap',[['sendMessage',['$event']]]]]}}" class="send-btn data-v-658354b7" bindtap="__e"><text class="send-text data-v-658354b7">发送</text></view></view></view></view>