<view class="detail-container data-v-3505dc7a"><view class="status-bar data-v-3505dc7a"><view class="status-desc data-v-3505dc7a">{{statusDesc}}</view></view><view class="info-card data-v-3505dc7a"><view class="card-title data-v-3505dc7a">预约信息</view><view class="info-list data-v-3505dc7a"><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">预约编号：</text><text class="value data-v-3505dc7a">{{appointmentDetail.id}}</text></view><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">服务类型：</text><text class="value data-v-3505dc7a">{{$root.m0}}</text></view><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">预约日期：</text><text class="value data-v-3505dc7a">{{$root.m1}}</text></view><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">预约时间：</text><text class="value data-v-3505dc7a">{{appointmentDetail.timeSlot}}</text></view><block wx:if="{{appointmentDetail.location}}"><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">服务地点：</text><text class="value data-v-3505dc7a">{{appointmentDetail.location}}</text></view></block><block wx:if="{{appointmentDetail.remark}}"><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">备注信息：</text><text class="value data-v-3505dc7a">{{appointmentDetail.remark}}</text></view></block></view></view><block wx:if="{{petInfo}}"><view class="info-card data-v-3505dc7a"><view class="card-title data-v-3505dc7a">宠物信息</view><view class="info-list data-v-3505dc7a"><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">宠物名称：</text><text class="value data-v-3505dc7a">{{petInfo.name}}</text></view><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">宠物品种：</text><text class="value data-v-3505dc7a">{{petInfo.breed}}</text></view><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">宠物年龄：</text><text class="value data-v-3505dc7a">{{petInfo.age+"岁"}}</text></view><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">宠物性别：</text><text class="value data-v-3505dc7a">{{petInfo.gender==='male'?'公':'母'}}</text></view></view></view></block><block wx:if="{{appointmentDetail.verifyCode}}"><view class="info-card data-v-3505dc7a"><view class="card-title data-v-3505dc7a">核销信息</view><view class="verify-info data-v-3505dc7a"><view class="qr-code-section data-v-3505dc7a"><view class="qr-code-container data-v-3505dc7a"><view class="qr-code-square data-v-3505dc7a"><image class="qr-image data-v-3505dc7a" src="{{qrCodeUrl}}" mode="aspectFill" data-event-opts="{{[['error',[['onQrImageError',['$event']]]]]}}" binderror="__e"></image></view><view class="qr-code-text data-v-3505dc7a">核销码</view><view class="qr-code-number data-v-3505dc7a">{{appointmentDetail.verifyCode}}</view></view></view><block wx:if="{{appointmentDetail.isVerified===1}}"><view class="verify-status data-v-3505dc7a"><text class="verified-text data-v-3505dc7a">✓ 已核销</text><text class="verify-time data-v-3505dc7a">{{$root.m2}}</text></view></block><block wx:else><view class="verify-status data-v-3505dc7a"><text class="unverified-text data-v-3505dc7a">○ 待核销</text></view></block></view></view></block><view class="info-card data-v-3505dc7a"><view class="card-title data-v-3505dc7a">时间信息</view><view class="info-list data-v-3505dc7a"><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">创建时间：</text><text class="value data-v-3505dc7a">{{$root.m3}}</text></view><view class="info-item data-v-3505dc7a"><text class="label data-v-3505dc7a">更新时间：</text><text class="value data-v-3505dc7a">{{$root.m4}}</text></view></view></view><view class="action-buttons data-v-3505dc7a"><block wx:if="{{appointmentDetail.status==='pending'}}"><view data-event-opts="{{[['tap',[['cancelAppointment',['$event']]]]]}}" class="action-button cancel-button data-v-3505dc7a" bindtap="__e"><text class="button-text data-v-3505dc7a">取消预约</text></view></block><block wx:if="{{appointmentDetail.status==='confirmed'}}"><view data-event-opts="{{[['tap',[['contactService',['$event']]]]]}}" class="action-button contact-button data-v-3505dc7a" bindtap="__e"><text class="button-text data-v-3505dc7a">联系客服</text></view></block><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="action-button primary-button data-v-3505dc7a" bindtap="__e"><text class="button-text data-v-3505dc7a">返回</text></view></view></view>