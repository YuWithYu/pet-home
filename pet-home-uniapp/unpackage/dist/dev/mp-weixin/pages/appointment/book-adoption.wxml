<view class="booking-container data-v-74b63a23"><view class="booking-form data-v-74b63a23"><view class="form-section data-v-74b63a23"><view class="section-title data-v-74b63a23">待领养宠物</view><block wx:if="{{adoptionPet}}"><view class="adoption-pet-info data-v-74b63a23"><image class="pet-image data-v-74b63a23" src="{{adoptionPet.imageUrl}}" mode="aspectFill"></image><view class="pet-details data-v-74b63a23"><view class="pet-name data-v-74b63a23">{{adoptionPet.petName}}</view><view class="pet-breed data-v-74b63a23">{{adoptionPet.breed+" · "+adoptionPet.age+"岁 · "+adoptionPet.gender}}</view><view class="adoption-fee data-v-74b63a23">{{"领养费用：¥"+adoptionPet.adoptionFee}}</view></view></view></block><block wx:else><view class="no-pet-selected data-v-74b63a23"><text class="data-v-74b63a23">请先选择要领养的宠物</text></view></block></view><view class="form-section data-v-74b63a23"><view class="section-title data-v-74b63a23">预约到店日期</view><picker mode="date" value="{{formData.appointmentDate}}" start="{{todayDate}}" end="{{maxDate}}" data-event-opts="{{[['change',[['onDateChange',['$event']]]]]}}" bindchange="__e" class="data-v-74b63a23"><view class="date-picker data-v-74b63a23"><view class="picker-value data-v-74b63a23">{{formData.appointmentDate||'请选择到店日期'}}</view><view class="picker-arrow data-v-74b63a23">›</view></view></picker></view><view class="form-section data-v-74b63a23"><view class="section-title data-v-74b63a23">预约时间</view><view class="time-slots data-v-74b63a23"><block wx:for="{{timeSlots}}" wx:for-item="slot" wx:for-index="__i0__" wx:key="value"><view data-event-opts="{{[['tap',[['selectTimeSlot',['$0'],[[['timeSlots','value',slot.value,'value']]]]]]]}}" class="{{['data-v-74b63a23','time-slot',[(formData.timeSlot===slot.value)?'selected':'']]}}" bindtap="__e">{{''+slot.label+''}}</view></block></view></view><view class="form-section data-v-74b63a23"><view class="section-title data-v-74b63a23">联系人信息</view><view class="contact-inputs data-v-74b63a23"><view class="input-row data-v-74b63a23"><view class="input-label data-v-74b63a23">姓名</view><input class="input-field data-v-74b63a23" placeholder="请输入您的姓名" maxlength="20" data-event-opts="{{[['input',[['__set_model',['$0','contactName','$event',[]],['formData']]]]]}}" value="{{formData.contactName}}" bindinput="__e"/></view><view class="input-row data-v-74b63a23"><view class="input-label data-v-74b63a23">手机号</view><input class="input-field data-v-74b63a23" placeholder="请输入手机号" type="number" maxlength="11" data-event-opts="{{[['input',[['__set_model',['$0','contactPhone','$event',[]],['formData']]]]]}}" value="{{formData.contactPhone}}" bindinput="__e"/></view><view class="input-row data-v-74b63a23"><view class="input-label data-v-74b63a23">身份证号</view><input class="input-field data-v-74b63a23" placeholder="请输入身份证号（用于领养审核）" maxlength="18" data-event-opts="{{[['input',[['__set_model',['$0','idCard','$event',[]],['formData']]]]]}}" value="{{formData.idCard}}" bindinput="__e"/></view><view class="input-row data-v-74b63a23"><view class="input-label data-v-74b63a23">居住地址</view><input class="input-field data-v-74b63a23" placeholder="请输入详细居住地址" maxlength="100" data-event-opts="{{[['input',[['__set_model',['$0','address','$event',[]],['formData']]]]]}}" value="{{formData.address}}" bindinput="__e"/></view></view></view><view class="form-section data-v-74b63a23"><view class="section-title data-v-74b63a23">领养原因</view><textarea class="reason-textarea data-v-74b63a23" placeholder="请简述您的领养原因和养宠经验（有助于审核通过）" maxlength="200" data-event-opts="{{[['input',[['__set_model',['$0','reason','$event',[]],['formData']]]]]}}" value="{{formData.reason}}" bindinput="__e"></textarea></view><view class="form-section data-v-74b63a23"><view class="section-title data-v-74b63a23">备注信息</view><textarea class="remark-textarea data-v-74b63a23" placeholder="其他需要说明的信息（选填）" maxlength="100" data-event-opts="{{[['input',[['__set_model',['$0','remark','$event',[]],['formData']]]]]}}" value="{{formData.remark}}" bindinput="__e"></textarea></view></view><view class="submit-section data-v-74b63a23"><button class="submit-button data-v-74b63a23" disabled="{{!canSubmit}}" data-event-opts="{{[['tap',[['submitBooking',['$event']]]]]}}" bindtap="__e">提交领养申请</button></view></view>