<view class="shop-container data-v-2f754cba"><view class="search-bar bg-white data-v-2f754cba"><view data-event-opts="{{[['tap',[['onSearchTap',['$event']]]]]}}" class="search-input flex items-center data-v-2f754cba" bindtap="__e"><view class="search-icon data-v-2f754cba"><image class="search-icon-image data-v-2f754cba" src="/static/images/搜索.svg" mode="aspectFit"></image></view><input class="search-text data-v-2f754cba" placeholder="请输入搜索关键词" disabled="{{true}}" data-event-opts="{{[['tap',[['onSearchTap',['$event']]]]]}}" bindtap="__e"/></view></view><view class="main-content data-v-2f754cba"><view class="category-sidebar data-v-2f754cba"><scroll-view class="category-scroll data-v-2f754cba" scroll-y="true" show-scrollbar="false"><block wx:for="{{categories}}" wx:for-item="category" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['onCategoryTap',['$0'],[[['categories','id',category.id]]]]]]]}}" class="{{['data-v-2f754cba','category-item',[(selectedCategory&&selectedCategory.id===category.id)?'active':'']]}}" bindtap="__e"><view class="category-name data-v-2f754cba">{{category.name}}</view></view></block></scroll-view></view><view class="goods-content data-v-2f754cba"><scroll-view class="goods-scroll data-v-2f754cba" scroll-y="true" data-event-opts="{{[['scrolltolower',[['loadMoreGoods',['$event']]]]]}}" bindscrolltolower="__e"><view class="goods-grid data-v-2f754cba"><block wx:for="{{goodsList}}" wx:for-item="goods" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['onGoodsTap',['$0'],[[['goodsList','id',goods.id]]]]]]]}}" class="goods-item data-v-2f754cba" bindtap="__e"><view class="goods-image data-v-2f754cba"><image src="{{goods.pic}}" mode="aspectFill" class="data-v-2f754cba"></image><block wx:if="{{goods.tag}}"><view class="goods-tag data-v-2f754cba">{{goods.tag}}</view></block></view><view class="goods-info data-v-2f754cba"><view class="goods-name data-v-2f754cba">{{goods.name}}</view><block wx:if="{{goods.description}}"