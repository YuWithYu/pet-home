  background: #f8f8f8;
  border-radius: 12rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}
.time-slot.active.data-v-ad84041a {
  background: #fff5f2;
  border-color: #ff6b35;
  color: #ff6b35;
}
.time-slot.disabled.data-v-ad84041a {
