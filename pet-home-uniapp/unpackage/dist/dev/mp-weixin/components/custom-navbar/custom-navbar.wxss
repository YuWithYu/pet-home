/* 自定义主题色 */
/* 全局样式重置和扩展 */
/* 页面容器 */
.page.data-v-4c5ea2c4 {
  min-height: 100vh;
  background-color: #f8f8f8;
}
/* 通用按钮样式 */
.btn.data-v-4c5ea2c4 {
  display: inline-block;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 28rpx;
  border: none;
  cursor: pointer;
}
.btn-primary.data-v-4c5ea2c4 {
  background-color: #ff6b35;
  color: white;
}
.btn-primary.data-v-4c5ea2c4:active {
  background-color: #ff4602;
}
.btn-secondary.data-v-4c5ea2c4 {
  background-color: #ffffff;
  color: #333;
  border: 1rpx solid #ddd;
}
.btn-secondary.data-v-4c5ea2c4:active {
  background-color: #eee;
}
/* 卡片样式 */
.card.data-v-4c5ea2c4 {
  background-color: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.card-header.data-v-4c5ea2c4 {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-weight: 600;
  font-size: 32rpx;
}
.card-body.data-v-4c5ea2c4 {
  padding: 30rpx;
}
.card-footer.data-v-4c5ea2c4 {
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
